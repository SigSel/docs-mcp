# Read-only PAT (Azure DevOps: Code > Read) or Forgejo token (read:repository).
DOCS_GIT_TOKEN=
# Optional for Forgejo/GitLab: the token's user name. Azure DevOps ignores it.
# DOCS_GIT_USERNAME=
# Clients send `Authorization: Bearer <this>`; also guards POST /refresh.
# Leave it empty when users sign in with Entra ID (MCP_OAUTH_ISSUER).
MCP_AUTH_TOKEN=
# The push webhook sends `Authorization: Bearer <this>` to POST /refresh.
# Required with Entra ID sign-in; optional otherwise.
MCP_REFRESH_TOKEN=
