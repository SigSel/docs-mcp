{
  "name": "docs-mcp",
  "version": "0.1.0",
  "description": "MCP server that serves a folder of Markdown docs from git",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "docs-mcp": "dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
